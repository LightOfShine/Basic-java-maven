<project>
  <groupId>contohprojectmaven</groupId>
  <artifactId>contohproject</artifactId>
  <version>0.3.5</version>   <!-- versi artifact yang akan dipublish -->

  <dependencies>
    <!-- JUnit untuk unit testing -->
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.11</version>
    </dependency>
  </dependencies>

  <!-- Target registry untuk CD (GitHub Packages) -->
  <distributionManagement>
    <repository>
      <id>github</id>
      <name>GitHub Packages</name>
      <url>https://maven.pkg.github.com/[USERNAME]/Basic-Java-Maven</url>
    </repository>
  </distributionManagement>
</project>
